{
  // Declaration-only emit for consumers. `@omadia/agent-linear` points its
  // tsconfig `paths` at the `dist/*.d.ts` this produces, the same way the
  // channel packages point at the adjacent core checkout's built dist.
  // The runtime JS comes from esbuild (scripts/build-zip.mjs), not tsc —
  // one bundled dist/plugin.js, zero runtime dependencies.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"]
}
